# Start the read-only API with:
# uv run uvicorn arbitmint.app:app --reload

# Mainnet read-only RPC; no wallet key is used or accepted.
UNICHAIN_RPC_URL=https://mainnet.unichain.org
UNICHAIN_USDC_ADDRESS=0x078d782b760474a361dda0af3839290b0ef57ad6
UNICHAIN_MAX_BLOCK_AGE_SECONDS=60

# Binance Spot fee assumption in basis points (10 = 0.10%). This is not account-specific.
BINANCE_TAKER_FEE_BPS=10
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# No pool keys are bundled or presumed. Add only independently verified full PoolKey data.
# Each entry requires: chain_id, token_address, token_decimals, usdc_address, pool_key
# (currency0, currency1, fee, tick_spacing, hooks); optional hook_data defaults to 0x.
# Set cex_symbol when Binance's base
# symbol differs from the on-chain token symbol (e.g. a verified WETH-to-ETH mapping).
UNISWAP_V4_POOLS_JSON={}
